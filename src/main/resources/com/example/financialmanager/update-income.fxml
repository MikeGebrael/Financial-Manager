<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="updateIncomePane" prefHeight="234.0" prefWidth="237.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.financialmanager.UpdateIncomeController">
    <children>
        <VBox layoutX="9.0" layoutY="14.0" prefHeight="182.0" prefWidth="219.0" spacing="10.0">
            <children>
                <TextField fx:id="nameField" promptText="Name" />
                <TextField fx:id="amountField" promptText="Amount" />
                <ComboBox fx:id="sourceComboBox" prefHeight="25.0" prefWidth="223.0">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Job" />
                            <String fx:value="Freelancing" />
                            <String fx:value="Child Support" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <DatePicker fx:id="datePicker" prefHeight="25.0" prefWidth="220.0" promptText="Date" />
                <TextField fx:id="descriptionField" promptText="Description" />
            </children>
        </VBox>
          <Button layoutX="91.0" layoutY="196.0" onAction="#updateIncome" text="Update" />
    </children>
</AnchorPane>
